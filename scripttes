sub OnExecAction(buttonId As Integer)

    if buttonId = 0 then

        for i = 0 to 19

            reorder_clear(i)

        next

        reorder_clear(1)


    elseif buttonId = 1 then

        exec_msg_layout_edited()


    elseif buttonId = 2 then

        println "AAA"

    end if

end sub
