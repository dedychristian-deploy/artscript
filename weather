sub LoadWeatherData()

    ' Load JSON file
    dim dataString as string
    System.loadTextFile(gDataPath, dataString)

    ' Parse JSON
    dim parser = scene.findContainer("JSONParser").script
    dim dataMap = (stringmap)parser.jsonDecode(dataString)

    ' Get weather cities
    dim cities = (stringmap)dataMap["weathercities"]
    gWeatherCities.clear()
    
    for i = 0 to (integer)cities["ubound"]
    
        dim cityMap = (stringmap)cities[(string)i]
        dim newCity as WeatherCity
    
        newCity.name = (string)cityMap["name"]
        newCity.conditionName = (string)cityMap["conditionAr"]
        newCity.highTemp = (string)cityMap["highTemp"]
        newCity.lowTemp = (string)cityMap["lowTemp"]
        newCity.icon = (string)cityMap["icon"]
        newCity.humidity = (string)cityMap["humidity"]
        newCity.windSpeed = (string)cityMap["windspeed"]
        newCity.windDirection = (string)cityMap["winddirection"]
        newCity.windRotation = GetRotationForWindDirection(newCity.windDirection)
    
        
	newCity.forecasts.clear()
	        		dim newForecast as DayForecast
	        		dim forecastsMap = (stringmap)cityMap["forecast"]
	        		for j = 0 to (integer)forecastsMap["ubound"]
	        			dim forecastMap = (stringmap)forecastsMap[(string)j]
	        			newForecast.dayName = (string)forecastMap["dayName"]
	        			newForecast.icon = (string)forecastMap["icon"]
	        			newForecast.high = (string)forecastMap["max"]
	        			newForecast.low = (string)forecastMap["min"]
	        			newCity.forecasts.push(newForecast)
	        		next        
        
        gWeatherCities.push(newCity)
    
    next

    println("JSON LOADED")
    println("TOTAL CITY = " & cities["length"])
    println("TOTAL STORED = " & gWeatherCities.size)
    println("FIRST CITY = " & gWeatherCities[0].name)

end sub

sub RenderCity(index as integer, panelNumber as integer)

    dim theCity = gWeatherCities[index]
    dim thePanel = scene.findContainer("Panel" & panelNumber)

    thePanel.findSubContainer("CityText").geometry.text = theCity.name
    thePanel.findSubContainer("ConditionText").geometry.text = theCity.conditionName
	thePanel.findSubContainer("WindSpeed").geometry.text = theCity.windSpeed
	thePanel.findSubContainer("highTemp").geometry.text = theCity.highTemp
	thePanel.findSubContainer("lowTemp").geometry.text = theCity.lowTemp
	thePanel.findSubContainer("Humidity").geometry.text = theCity.humidity
	if (theCity.windSpeed <> "") then
		thePanel.findSubContainer("Wind").active = true
		thePanel.findSubContainer("WindSpeedText").geometry.text = theCity.windSpeed
		thePanel.findSubContainer("WIND$Direction").rotation.z = theCity.windRotation.z
	else
		thePanel.findSubContainer("WIND").active = true	
	end if	
	
	dim forecastContainer = thePanel.findSubContainer("BOTTOM")
	'for i = 0 to forecastContainer.childContainerCount-1
	for i = 0 to theCity.forecasts.ubound
		dim c = forecastContainer.getChildContainerByIndex(i)
		c.findSubContainer("DayNameText").geometry.text = theCity.forecasts[i].dayName
		'SetIconOnContainer(c.findSubContainer("WeatherIcon"),theCity.forecasts[i].icon,false)
		c.findSubContainer("HIGH$TemperatureText").geometry.text = theCity.forecasts[i].high		
		c.findSubContainer("LOW$TemperatureText").geometry.text = theCity.forecasts[i].low		
	next

end sub

