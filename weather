function GetRotationForWindDirection(direction as string) as vertex
    dim dirVertex as vertex
    select case direction
        case "N"
            dirVertex.z = 90.0
        case "NE"
            dirVertex.z = 45.0
        case "E"
            dirVertex.z = 0.0
        case "SE"
            dirVertex.z = -45.0
        case "S"
            dirVertex.z = -90.0
        case "SW"
            dirVertex.z = -135.0
        case "W"
            dirVertex.z = -180.0
        case "NW"
            dirVertex.z = -225.0
    end select
'dirVertex.z = 90
    GetRotationForWindDirection = dirVertex
end function




sub startShow()

    LoadWeatherData()

    gCurrentCityIndex = 0
    gCurrentMainIndex = 1

    InitMainPanels()
    InitHighlightPanels()

end sub


sub NextItem()

    gCurrentMainIndex++

    if (gCurrentMainIndex > gWeatherCities.ubound) then
        gCurrentMainIndex = 0
    end if

    gCurrentCityIndex++

    if (gCurrentCityIndex > gWeatherCities.ubound) then
        gCurrentCityIndex = 0
    end if


    dim nextCityIndex = gCurrentMainIndex

    for i = 1 to 2

        nextCityIndex++

        if (nextCityIndex > gWeatherCities.ubound) then
            nextCityIndex = 0
        end if

    next

    RenderCity(nextCityIndex, 4)

    stage.findDirector("MessageChange").startAnimation()

end sub

sub OnNextItemTransition()

    dim nextIndex = gCurrentMainIndex

    for i = 1 to 3

        RenderCity(nextIndex, i)

        nextIndex++

        if (nextIndex > gWeatherCities.ubound) then
            nextIndex = 0
        end if

    next


    RenderHighlight(gCurrentCityIndex, 1)

    dim nextHighlightIndex = gCurrentCityIndex + 1

    if (nextHighlightIndex > gWeatherCities.ubound) then
        nextHighlightIndex = 0
    end if

    RenderHighlight(nextHighlightIndex, 2)

end sub


sub OnExecAction(buttonId As Integer)

    if buttonId = 0 then

        LoadWeatherData()

        gCurrentCityIndex = 0
        gCurrentMainIndex = 1

        InitMainPanels()
        InitHighlightPanels()

    elseif buttonId = 1 then

        NextItem()

    end if

end sub
