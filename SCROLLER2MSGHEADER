Dim cTemplates, cProduction, cArea, cInput As Container
Dim animationStatus, intentionStatus, delimiter as String
Dim startY, endY As Double
Dim v1, v2 As Vertex
Dim sourceText As String
Dim arrSourceLines As Array[String]

Structure CrawlItem
    sourceText As String
    type As String
    parameter As String
    text As String
    gap As Double
    cTemplate As Container
End Structure

Dim arrCrawlItems As Array[CrawlItem]
Dim currentItemIndex As Integer
Dim arrActiveItems As Array[Container]
Dim sourceMode As Integer
Dim sourceModes As Array[String]

sourceModes.Push("text")
sourceModes.Push("container")
sourceModes.Push("SHM")

Dim SOURCE_MODE_TEXT = 0
Dim SOURCE_MODE_CONTAINER = 1
Dim SOURCE_MODE_SHM = 2
Dim BUTTON_INIT = 1
Dim BUTTON_START = 2
Dim BUTTON_PAUSE = 3
Dim BUTTON_CONTINUE = 4
Dim BUTTON_FINISH = 5
Dim BUTTON_REFRESH = 6
Dim isPaused As Boolean = false
Dim pauseCounter As Integer = 0
Dim pauseTarget As Container

sub OnInitParameters()
    RegisterParameterContainer("templates", "Templates")
    RegisterParameterContainer("production", "Production")
    RegisterParameterContainer("area", "Bounding box area")
    RegisterParameterContainer("dot", "Red Dot")
    RegisterParameterDouble("speed", "Speed", 20, 0, 9999)
    RegisterParameterDouble("gap", "Default gap", 10, 0, 9999)
    RegisterParameterString("delimiter", "Source delimiter", "\\n", 100, 999, "")
    RegisterRadioButton("source_mode", "Source mode", 0, sourceModes)
    RegisterParameterText("source_text", "Source text", 100, 100)
    RegisterParameterContainer("source_container", "Source text container")
    RegisterParameterString("source_shm", "Source SHM variable", "", 100, 999, "")
    RegisterPushButton("init", "Initialize", BUTTON_INIT)
    RegisterPushButton("start", "Start", BUTTON_START)
    RegisterPushButton("pause", "Pause", BUTTON_PAUSE)
    RegisterPushButton("continue", "Continue", BUTTON_CONTINUE)
    RegisterPushButton("finish", "Finish", BUTTON_FINISH)
    RegisterParameterDouble("pause_y", "Pause Y", 0, -9999, 9999)
    RegisterParameterInt("pause_frames", "Pause Frames", 100, 0, 1000)
    RegisterParameterDouble("initial_y", "Initial Y", 0, -9999, 9999)
	RegisterPushButton("refresh", "Refresh Preview", BUTTON_REFRESH)
end sub

sub OnParameterChanged(parameterName As String)
    OnInit()
    SendGuiParameterShow("source_text", CInt(sourceMode == SOURCE_MODE_TEXT))
    SendGuiParameterShow("source_container", CInt(sourceMode == SOURCE_MODE_CONTAINER))
    SendGuiParameterShow("source_shm", CInt(sourceMode == SOURCE_MODE_SHM))
    if parameterName == "source_text" then
        PrepareItems()
    end if
    if sourceMode == SOURCE_MODE_CONTAINER then
        System.Map.UnregisterChangedCallback(GetParameterString("source_shm"))
        cInput = GetParameterContainer("source_container")
        if cInput <> null then
            cInput.geometry.RegisterTextChangedCallback()
        end if
    elseif sourceMode == SOURCE_MODE_SHM then
        if cInput <> null then
            cInput.geometry.UnregisterChangedCallback()
       end if
       System.Map.RegisterChangedCallback(GetParameterString("source_shm"))
   
		end if
end sub

sub OnInit()
    sourceMode = GetParameterInt("source_mode")
    cTemplates = GetParameterContainer("templates")
    cProduction = GetParameterContainer("production")
    cArea = GetParameterContainer("area")
    delimiter = GetParameterString("delimiter")
    if delimiter == "\\n" then
        delimiter = "\n"
    end if
    if cTemplates == null OR cProduction == null OR cArea == null then
        exit sub
    end if
    cArea.GetTransformedBoundingBox(v1, v2)
    startY = v1.y
    endY = v2.y
    println "START Y = " & CStr(startY)
    println "END Y = " & CStr(endY)
end sub

sub OnExecAction(buttonId As Integer)
    if buttonId = BUTTON_INIT then
        OnInit()
        CleanupProduction()
        PrepareItems()
        animationStatus = "stop"
    elseif buttonId = BUTTON_START then
        Start()
    elseif buttonId = BUTTON_PAUSE then
        animationStatus = "pause"
    elseif buttonId = BUTTON_CONTINUE then
        animationStatus = "play"
    elseif buttonId = BUTTON_FINISH then
        intentionStatus = "stop"
     elseif buttonId = BUTTON_REFRESH then
     	RefreshPreview()
    end if
end sub

sub OnExecPerField()
    'stage.findDirector("LOOP").time = 0
    'stage.findDirector("LOOP").continueanimation()
    if animationStatus == "play" then
        if isPaused then
            pauseCounter -= 1
            if pauseCounter <= 0 then
                isPaused = false
                SetNextPauseTarget()
            end if
        else
            for i = 0 to arrActiveItems.ubound
                arrActiveItems[i].position.y += GetParameterDouble("speed") / 50.0
                arrActiveItems[i].RecomputeMatrix()
            next
            DetectStop()
            DetectAndDeleteOutsiders()
            DetectAndCreateNextItem()
        end if
    end if
end sub

sub OnGeometryChanged(geom As Geometry)
    PrepareItems()
end sub

sub OnSharedMemoryVariableChanged(map As SharedMemory, mapKey As String)
    PrepareItems()
end sub

Sub CleanupProduction()
    if cProduction == null then
        exit sub
    end if
    cProduction.DeleteChildren()
    arrActiveItems.Clear()
    isPaused = false
    pauseCounter = 0
    pauseTarget = null
End Sub

Dim renderableTypes As StringMap
renderableTypes["text"] = true
renderableTypes["container"] = true

Sub PrepareItems()
    if sourceMode == SOURCE_MODE_TEXT then
        sourceText = GetParameterString("source_text")
    elseif sourceMode == SOURCE_MODE_CONTAINER then
        sourceText = GetParameterContainer("source_container").geometry.text
    elseif sourceMode == SOURCE_MODE_SHM then
        sourceText = CStr(System.Map[GetParameterString("source_shm")])
    end if
    sourceText.Trim()
    sourceText.Split(delimiter, arrSourceLines)
    arrCrawlItems.Clear()
    if sourceText == "" then
        exit sub
    end if
    Dim cTextTemplate = cTemplates.FirstChildContainer
    Dim gap = GetParameterDouble("gap")
    for i = 0 to arrSourceLines.ubound
        Dim item As CrawlItem
        item.sourceText = arrSourceLines[i]
        item.text = item.sourceText
        item.text.Trim()
        item.gap = gap
        Dim sItemTextToCompare = item.text
        sItemTextToCompare.MakeLower()
        Dim containerTagName = "container"
        Dim setterTagName = "set"
        if sItemTextToCompare.StartsWith("<" & containerTagName) then
            item.type = "container"
            Dim openTagIndex = 2 + containerTagName.length
            Dim closeTagIndex = item.text.Find(">")
            Dim sElementName = item.text.GetSubstring(openTagIndex, closeTagIndex - openTagIndex)
            sElementName.Trim()
            item.cTemplate = cTemplates.findSubContainer(sElementName)
        elseif sItemTextToCompare.StartsWith("<" & setterTagName) then
            item.type = "set"
            Dim openTagIndex = 2 + setterTagName.length
            Dim closeTagIndex = item.text.Find(">")
            Dim sSetCommand = item.text.GetSubstring(openTagIndex, closeTagIndex - openTagIndex)
            Dim iCommandSeparatorIndex = sSetCommand.Find(" ")
            Dim sParameterName = sSetCommand.Left(iCommandSeparatorIndex)
            Dim sParameterValue = sSetCommand.Right(sSetCommand.length - iCommandSeparatorIndex - 1)
            item.parameter = sParameterName
            if sParameterName == "template" then
                Dim cTemplate = cTemplates.findSubContainer(sParameterValue)
                if cTemplate <> null then
                    item.cTemplate = cTemplate
                    cTextTemplate = cTemplate
                end if
            elseif sParameterName == "gap" OR sParameterName == "step" then
                gap = CDbl(sParameterValue)
            end if
        elseif item.text <> "" then
            item.type = "text"
            item.cTemplate = cTextTemplate
        end if
        if renderableTypes.ContainsKey(item.type) then
            arrCrawlItems.Push(item)
        end if
        PrintItem(item)
    next
End Sub

Sub InsertNextItem()
    if intentionStatus == "stop" then
        exit sub
    end if
    if arrCrawlItems.size <= 0 then
        exit sub
    end if
    currentItemIndex += 1
    currentItemIndex = currentItemIndex mod arrCrawlItems.size
    if currentItemIndex > arrCrawlItems.ubound then
        exit sub
    end if

    Dim cLast As Container
    cLast = null
    if arrActiveItems.size > 0 then
        cLast = arrActiveItems[arrActiveItems.ubound]
    end if

    Dim newItemPositionY As Double
    newItemPositionY = startY

    if cLast <> null then
        Dim cLastText As Container
        cLastText = cLast.findSubContainer("=text")
        Dim lastV1 As Vertex
        Dim lastV2 As Vertex
        if cLastText <> null then
            cLastText.GetTransformedBoundingBox(lastV1, lastV2)
        else
            cLast.GetTransformedBoundingBox(lastV1, lastV2)
        end if
        Dim currentV1 As Vertex
        Dim currentV2 As Vertex
        newItemPositionY = cLast.position.y - (lastV2.y - lastV1.y) - arrCrawlItems[currentItemIndex].gap
    end if

    Dim cNew As Container
    cNew = arrCrawlItems[currentItemIndex].cTemplate.CopyTo(cProduction, TL_DOWN)
    if cNew == null then
        exit sub
    end if

    cNew.position.xyz = CVertex(0, newItemPositionY, 0)

    if arrCrawlItems[currentItemIndex].type == "text" then
    
        Dim textParts As Array[String]
        Dim cText As Container
        Dim cText2 As Container
    
        arrCrawlItems[currentItemIndex].text.Split("|", textParts)
    
        cText = cNew.findSubContainer("=text")
        cText2 = cNew.findSubContainer("=text2")
    
        if cText <> null then
            if textParts.size > 0 then
                cText.geometry.text = textParts[0]
            else
                cText.geometry.text = ""
            end if
        end if
    
        if cText2 <> null then
            if textParts.size > 1 then
                cText2.geometry.text = textParts[1]
            else
                cText2.geometry.text = ""
            end if
        end if
    
    end if

    cNew.RecomputeMatrix()
    arrActiveItems.Push(cNew)
End Sub

Sub Start()
    intentionStatus = ""
    currentItemIndex = -1
    isPaused = false
    pauseCounter = 0
    pauseTarget = null
    CleanupProduction()
    currentItemIndex = -1
    ' FIRST
    InsertNextItem()

    Dim areaV1 As Vertex
    Dim areaV2 As Vertex
    Dim prodV1 As Vertex
    Dim prodV2 As Vertex
    Dim areaHeight As Double
    Dim productionHeight As Double
    cArea.GetTransformedBoundingBox(areaV1, areaV2)
    areaHeight = areaV2.y - areaV1.y

    for i = 0 to 99
        cProduction.GetTransformedBoundingBox(prodV1, prodV2)
        productionHeight = prodV2.y - prodV1.y
        if productionHeight >= areaHeight then
            exit for
        end if
        InsertNextItem()
    next

    Dim initialY As Double
    initialY = GetParameterDouble("initial_y")
    for i = 0 to arrActiveItems.ubound
        arrActiveItems[i].position.y += initialY
        arrActiveItems[i].RecomputeMatrix()
    next

    if arrActiveItems.size > 0 then
        pauseTarget = arrActiveItems[0]
    end if
    animationStatus = "play"
End Sub

Sub DetectAndDeleteOutsiders()
    for i = 0 to arrActiveItems.ubound
        Dim cCheck As Container
        cCheck = arrActiveItems[i].findSubContainer("=text")
        if cCheck == null then
            cCheck = arrActiveItems[i]
        end if
        Dim itemV1 As Vertex
        Dim itemV2 As Vertex
        cCheck.GetTransformedBoundingBox(itemV1, itemV2)
        if itemV1.y > endY then
            if pauseTarget == arrActiveItems[i] then
                pauseTarget = null
            end if
            arrActiveItems[i].Delete()
            arrActiveItems.Erase(i)
            i -= 1
        end if
    next
    if arrActiveItems.size <= 0 then
        animationStatus = "stop"
    end if
End Sub

Sub DetectAndCreateNextItem()

    if arrActiveItems.size <= 0 then
        exit sub
    end if

    if arrCrawlItems.size <= 0 then
        exit sub
    end if

    if currentItemIndex < 0 then
        currentItemIndex = 0
    elseif currentItemIndex > arrCrawlItems.ubound then
        currentItemIndex = currentItemIndex mod arrCrawlItems.size
    end if

    cProduction.GetTransformedBoundingBox(v1, v2)

    Dim currentGap As Double
    currentGap = arrCrawlItems[currentItemIndex].gap

    if startY - currentGap < v1.y then
        InsertNextItem()
    end if

End Sub

Sub DetectStop()
    if pauseTarget == null then
        exit sub
    end if
    Dim pauseY As Double
    pauseY = endY
    if pauseTarget.position.y >= pauseY then
        Dim correction As Double
        correction = pauseY - pauseTarget.position.y
        for i = 0 to arrActiveItems.ubound
            arrActiveItems[i].position.y += correction
            arrActiveItems[i].RecomputeMatrix()
        next
        isPaused = true
        pauseCounter = GetParameterInt("pause_frames")
        getparametercontainer("dot").getDirector().time = 0.3
        getparametercontainer("dot").getDirector().continueanimation()
        'scene.stage.findDirector("LOOPDOT").time = 0.3
        'scene.stage.findDirector("LOOPDOT").continueanimation()
    end if
End Sub

Sub SetNextPauseTarget()
    pauseTarget = null
    if arrActiveItems.size <= 0 then
        exit sub
    end if
    Dim pauseY As Double
    pauseY = endY
    for i = 0 to arrActiveItems.ubound
        if arrActiveItems[i].position.y < pauseY then
            pauseTarget = arrActiveItems[i]
            exit sub
        end if
    next
End Sub

Sub PrintItem(item As CrawlItem)
    println("type=" & item.type & "| text=" & item.text & "|c=" & item.cTemplate.name & "|p=" & item.parameter & "|gap=" & item.gap)
End Sub

Sub RefreshPreview()

    intentionStatus = ""
    currentItemIndex = -1

    isPaused = false
    pauseCounter = 0
    pauseTarget = null

    CleanupProduction()
    PrepareItems()

    currentItemIndex = -1

    InsertNextItem()

    Dim areaV1 As Vertex
    Dim areaV2 As Vertex
    Dim prodV1 As Vertex
    Dim prodV2 As Vertex

    Dim areaHeight As Double
    Dim productionHeight As Double

    cArea.GetTransformedBoundingBox(areaV1, areaV2)
    areaHeight = areaV2.y - areaV1.y

    for i = 0 to 99

        cProduction.GetTransformedBoundingBox(prodV1, prodV2)
        productionHeight = prodV2.y - prodV1.y

        if productionHeight >= areaHeight then
            exit for
        end if

        InsertNextItem()

    next

    Dim initialY As Double
    initialY = GetParameterDouble("initial_y")

    for i = 0 to arrActiveItems.ubound

        arrActiveItems[i].position.y += initialY
        arrActiveItems[i].RecomputeMatrix()

    next

    if arrActiveItems.size > 0 then
        pauseTarget = arrActiveItems[0]
    end if

    animationStatus = "stop"

End Sub
