' ============================================================
' COPY HIGHLIGHT SCROLL KEY
' SAMA DENGAN SOCIAL
' ============================================================

sub copyKey()

    dim dir as director
    dim kf as keyframe
    dim kf2 as keyframe

    dir = GetParameterContainer("messageContainer").GetDirector()

    kf = dir.findkeyframe("H1Scroll")
    kf2 = dir.findkeyframe("H2Scroll")

    kf.xyzvalue.y = kf2.xyzvalue.y

    kf.updateanimation()
    kf2.updateanimation()

end sub


' ============================================================
' BUTTON ACTION
' PERSIS FLOW SOCIAL
' ============================================================

sub OnExecAction(buttonId As Integer)

    if buttonId = 0 then

        Scene.Map["initloadlt"] = "init"

        startShow()

        dim dirm as director = messageContainer.getDirector()
        dim dirt as director = timerContainer.getDirector()

        dirt.startAnimation()

        dirm.time = 0
        dirm.stopAnimation()


    elseif buttonId = 1 then

        OnNextItemTransition()

        dim dirm as director = messageContainer.getDirector()

        dirm.time = 0
        dirm.continueAnimation()

        NextItem()


    elseif buttonId = 2 then

        dim dirm as director = messageContainer.getDirector()

        dirm.time = 0
        dirm.startAnimation()


    elseif buttonId = 3 then

        dim dirm as director = messageContainer.getDirector()
        dim dirt as director = timerContainer.getDirector()

        dirm.time = 0
        dirm.stopAnimation()

        dirt.time = 0
        dirt.stopAnimation()

    end if

end sub
