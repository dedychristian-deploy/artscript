' ============================================================
' NEXT ITEM TRANSITION
' PERSIS FLOW SOCIAL
' ============================================================

sub OnNextItemTransition()

    copyKey()

    Scene.Map["initloadlt"] = "loop"


    ' --------------------------------------------------------
    ' MAIN
    ' --------------------------------------------------------

    dim nextIndex = gCurrentMainIndex + 1

    if (nextIndex > gWeatherCities.ubound) then
        nextIndex = 0
    end if


    for i = 1 to 3

        RenderCity(nextIndex, i)

        nextIndex++

        if (nextIndex > gWeatherCities.ubound) then
            nextIndex = 0
        end if

    next


    ' --------------------------------------------------------
    ' HIGHLIGHT
    ' --------------------------------------------------------

    dim currentHighlightIndex = gCurrentHighlightIndex + 1

    if (currentHighlightIndex > gWeatherCities.ubound) then
        currentHighlightIndex = 0
    end if


    RenderHighlight(currentHighlightIndex, 1)


    dim nextHighlightIndex = currentHighlightIndex + 1

    if (nextHighlightIndex > gWeatherCities.ubound) then
        nextHighlightIndex = 0
    end if


    RenderHighlight(nextHighlightIndex, 2)

end sub


' ============================================================
' UPDATE INDEX
' PERSIS FLOW SOCIAL
' ============================================================

sub NextItem()

    Scene.Map["initloadlt"] = "loop"


    ' Main

    gCurrentMainIndex++

    if (gCurrentMainIndex > gWeatherCities.ubound) then
        gCurrentMainIndex = 0
    end if


    ' Highlight

    gCurrentHighlightIndex++

    if (gCurrentHighlightIndex > gWeatherCities.ubound) then
        gCurrentHighlightIndex = 0
    end if

end sub


