' ============================================================
' WIND ROTATION
' ============================================================

function GetRotationForWindDirection(direction as string) as vertex

    dim dirVertex as vertex

    select case direction

        case "N"
            dirVertex.z = 90.0

        case "NE"
            dirVertex.z = 45.0

        case "E"
            dirVertex.z = 0.0

        case "SE"
            dirVertex.z = -45.0

        case "S"
            dirVertex.z = -90.0

        case "SW"
            dirVertex.z = -135.0

        case "W"
            dirVertex.z = -180.0

        case "NW"
            dirVertex.z = -225.0

    end select

    GetRotationForWindDirection = dirVertex

end function


